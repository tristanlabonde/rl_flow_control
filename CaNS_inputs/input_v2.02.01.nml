&dns
ng(1:3) = 512, 128, 160
l(1:3) = 30., 3., 3.
gtype = 2, gr = 0.
cfl = 0.95, dtmax = 1.e5, dt_f = -1.
visci = 2000.
inivel = 'uni'
is_wallturb = T
nstep = 2000, time_max = 100., tw_max = 0.1
stop_type(1:3) = T, F, F
restart = F, is_overwrite_save = T, nsaves_max = 0
icheck = 10, iout0d = 10, iout1d = 100, iout2d = 0, iout3d = 1000, isave = 5000
cbcvel(0:1,1:3,1) = 'P','P',  'P','P',  'D','D'
cbcvel(0:1,1:3,2) = 'P','P',  'P','P',  'D','N'
cbcvel(0:1,1:3,3) = 'P','P',  'P','P',  'D','N'
cbcpre(0:1,1:3)   = 'P','P',  'P','P',  'N','D'
bcvel(0:1,1:3,1) =  0.,0.,   0.,0.,   0.,1.
bcvel(0:1,1:3,2) =  0.,0.,   0.,0.,   0.,0.
bcvel(0:1,1:3,3) =  0.,0.,   0.,0.,   0.,0.
bcpre(0:1,1:3)   =  0.,0.,   0.,0.,   0.,0.
bforce(1:3) = 0., 0., 0.
is_forced(1:3) = F, F, F
velf(1:3) = 0., 0., 0.
gacc(1:3) = 0., 0., 0.
nscal     = 1
dims(1:2) = 0, 0, ipencil_axis = 1
is_stat   = T !under dev.
is_fringe = T ! for spatial developing flow
/

&ctrl
!shape 
is_vpm = F
is_sphere = F
is_owb = F
!active 
is_pa = F
amp_pa = 0.2
x_pa = 5.0
z_pa = 0.0
lx_pa = 0.2
ly_pa = 10.0
lz_pa = 0.1
ang_pa= 135.0
!adjoint 
is_adjoint = F
cbcadjvel(0:1,1:3,1) = 'P','P',  'P','P',  'D','D'
cbcadjvel(0:1,1:3,2) = 'P','P',  'P','P',  'D','D'
cbcadjvel(0:1,1:3,3) = 'P','P',  'P','P',  'D','N'
cbcadjpre(0:1,1:3)   = 'P','P',  'P','P',  'N','P'
bcadjvel(0:1,1:3,1) =  0.,0.,   0.,0.,   1.,0.
bcadjvel(0:1,1:3,2) =  0.,0.,   0.,0.,   0.,0.
bcadjvel(0:1,1:3,3) =  0.,0.,   0.,0.,   0.,0.
bcadjpre(0:1,1:3)   =  0.,0.,   0.,0.,   0.,0.
/

&scalar
iniscal(:)             = 'zer'
alphai(:)              = 2000.
beta                   = 1.
cbcscal(0:1,1:3,:)     = 'P','P' ,  'P','P',  'D','D'
bcscal(0:1,1:3,:)      =  0.,0. ,   0.,0. ,   0.,1.
ssource(:)             = 0.
is_sforced(:)          = F
scalf(:)               = 0.
is_boussinesq_buoyancy = F
/

&cudecomp
cudecomp_t_comm_backend = 0, cudecomp_is_t_enable_nccl = T, cudecomp_is_t_enable_nvshmem = T
cudecomp_h_comm_backend = 0, cudecomp_is_h_enable_nccl = T, cudecomp_is_h_enable_nvshmem = T
/

&numerics
is_impdiff = F, is_impdiff_1d = F
is_poisson_pcr_tdma = F
/

&other_options
is_debug = T, is_timing = T
/

&io
io_backend = 'mpiio'
/

